# ═══════════════════════════════════════════════════
# ASTrea 环境配置模板
# 
# 使用方法：
#   1. 在 ASTrea TUI 中执行 /config init 自动生成用户级配置
#   2. 或复制本文件并重命名为 .env
#   3. 填入你自己的 API Key
#
#   cp .env.example .env    # Linux/macOS
#   copy .env.example .env  # Windows
# ═══════════════════════════════════════════════════


# ─────────────────────────────────────────────────
# Provider 配置（至少启用一个）
# 
# 格式：<NAME>_API_KEY / <NAME>_BASE_URL / <NAME>_MODELS
# 系统内置支持 DeepSeek / Qwen / OpenAI-Compatible / GPT。
# ─────────────────────────────────────────────────

# ── Provider 1: DeepSeek（推荐，性价比高）──
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODELS=deepseek-chat,deepseek-reasoner

# ── Provider 2: Qwen（阿里云通义千问）──
# QWEN_API_KEY=sk-your-qwen-key-here
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── Provider 3: OpenAI / GPT 兼容（官方或中转）──
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODELS=gpt-4o,gpt-4o-mini

# ── 更多 Provider：任意兼容 OpenAI SDK 的服务 ──
# 自定义 Provider 可在 config/custom_providers.json 中通过 JSON 配置


# ─────────────────────────────────────────────────
# 模型选择
# 
# 指定各角色使用的模型名称（须属于上方某个 Provider 的 MODELS 列表）
# ─────────────────────────────────────────────────

MODEL_MASTER=deepseek-chat


# ─────────────────────────────────────────────────
# 深度思考（Thinking）
# 
# 可选值: false / true / max
#   false - 关闭深度思考（速度快、成本低）
#   true  - 开启（reasoning_effort=high）
#   max   - 最大强度（默认,reasoning_effort=max，慢但质量最高）
# ─────────────────────────────────────────────────

THINKING_MASTER=false


# ─────────────────────────────────────────────────
# 其他可选配置
# ─────────────────────────────────────────────────

# Token 用量预警阈值（单次对话累计 Token 超过此值时提醒）
# TOKEN_WARNING_LIMIT=50000
